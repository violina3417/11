++FNiagaraScratchResult UNiagaraScratchPadService::RefreshModuleCallNodes(
++	const FString& SystemPath,
++	const FString& EmitterName,
++	const FString& ModuleName)
++{
++	FNiagaraScratchResult R;
++	UNiagaraSystem* System = LoadSystem(SystemPath);
++	if (!System) { R.Message = TEXT("System not found"); return R; }
++	FNiagaraEmitterHandle* Handle = FindEmitterHandle(System, EmitterName);
++	if (!Handle) { R.Message = TEXT("Emitter not found"); return R; }
++	UNiagaraGraph* StackGraph = GetEmitterGraph(Handle->GetEmitterData());
++	if (!StackGraph) { R.Message = TEXT("Emitter graph not found"); return R; }
++
++	TArray<UNiagaraNodeFunctionCall*> Calls;
++	StackGraph->GetNodesOfClass<UNiagaraNodeFunctionCall>(Calls);
++
++	int32 Refreshed = 0;
++	for (UNiagaraNodeFunctionCall* Call : Calls)
++	{
++		if (!Call || !IsEmbeddedModuleScript(Call->FunctionScript)) continue;
++		const bool bMatch = Call->GetFunctionName().Equals(ModuleName, ESearchCase::IgnoreCase) ||
++			(Call->FunctionScript && Call->FunctionScript->GetName().Equals(ModuleName, ESearchCase::IgnoreCase));
++		if (!bMatch) continue;
++		Call->Modify();
++		Call->RefreshFromExternalChanges();
++		++Refreshed;
++	}
++
++	System->MarkPackageDirty();
++	R.bSuccess = true;
++	R.Message = FString::Printf(TEXT("refreshed %d call node(s) for module '%s'"), Refreshed, *ModuleName);
++	return R;
++}
