++FNiagaraScratchResult UNiagaraScratchPadService::RemoveScratchPin(
++	const FString& SystemPath,
++	const FString& EmitterName,
++	const FString& ModuleName,
++	const FString& NodeId,
++	const FString& PinName)
++{
++	FNiagaraScratchResult R;
++	UNiagaraSystem* System = LoadSystem(SystemPath);
++	if (!System) { R.Message = TEXT("System not found"); return R; }
++	FNiagaraEmitterHandle* Handle = FindEmitterHandle(System, EmitterName);
++	if (!Handle) { R.Message = TEXT("Emitter not found"); return R; }
++	UNiagaraNodeFunctionCall* Call = FindModuleNodeOnEmitter(Handle->GetEmitterData(), ModuleName);
++	UNiagaraGraph* Graph = GetScratchGraphFromCall(Call);
++	if (!Graph) { R.Message = TEXT("Scratch module not found"); return R; }
++	UEdGraphNode* Node = FindNodeByGuid(Graph, NodeId);
++	if (!Node) { R.Message = TEXT("Node not found"); return R; }
++
++	UEdGraphPin* Target = FindPinByName(Node, PinName, EGPD_Output, /*constrain*/ true);
++	if (!Target) { Target = FindPinByName(Node, PinName, EGPD_Input, /*constrain*/ true); }
++	if (!Target) { R.Message = FString::Printf(TEXT("Pin '%s' not found"), *PinName); return R; }
++
++	// RequestNewTypedPin pairs every mapped-variable output with a hidden default-value input pin
++	// directly after it (named "None"); leaving the pair behind would keep the map entry alive.
++	TArray<UEdGraphPin*> ToRemove;
++	ToRemove.Add(Target);
++	const int32 Idx = Node->Pins.IndexOfByKey(Target);
++	if (Idx != INDEX_NONE && Idx + 1 < Node->Pins.Num())
++	{
++		UEdGraphPin* Next = Node->Pins[Idx + 1];
++		if (Next && Next != Target && Next->Direction == EGPD_Input && Next->PinName == TEXT("None"))
++		{
++			ToRemove.Add(Next);
++		}
++	}
++
++	Graph->Modify();
++	Node->Modify();
++	for (UEdGraphPin* Pin : ToRemove)
++	{
++		Pin->BreakAllPinLinks();
++		Node->RemovePin(Pin);
++	}
++	Graph->NotifyGraphChanged();
++	System->MarkPackageDirty();
++
++	R.bSuccess = true;
++	R.Message = FString::Printf(TEXT("removed %d pin(s)"), ToRemove.Num());
++	return R;
++}
