+float amp = min(Amplitude, MaxWiggleRatio * len / max(SR, 0.0001));
+float seg = 0.0;
+for (int lv = 0; lv < 12; lv++)
+{
+    float wgt = ((float)lv < levelsF) ? 1.0 : 0.0;
+    float mid = 0.5 * (lo + hi);
+    float h = 0.5 * (hi - lo);
+    uint hBase = seedU ^ ((uint)lv * 0x9E3779B9u) ^ ((uint)seg * 0x85EBCA6Bu);
+    uint ha = hBase * 747796405u + 2891336453u;
+    ha = ((ha >> ((ha >> 28u) + 4u)) ^ ha) * 277803737u;
+    ha = (ha >> 22u) ^ ha;
+    uint hb = (hBase ^ 0x5BF03635u) * 747796405u + 2891336453u;
+    hb = ((hb >> ((hb >> 28u) + 4u)) ^ hb) * 277803737u;
+    hb = (hb >> 22u) ^ hb;
+    float h1 = ((float)(ha & 0xFFFFFFu) / 8388608.0) - 1.0;
+    float h2 = ((float)(hb & 0xFFFFFFu) / 8388608.0) - 1.0;
+    float w = (1.0 - abs(t - mid) / max(h, 0.000001)) * wgt;
+    off += (side * h1 + up2 * h2) * (amp * w);
+    if (t <= mid) { hi = mid; seg = seg * 2.0; }
+    else { lo = mid; seg = seg * 2.0 + 1.0; }
+    amp = amp * Roughness;
+}
+
+float isLastTrunk = (ipid == PointCount - 1) ? 1.0 : 0.0;
+float isOverflow = (ipid > PointCount - 1) ? 1.0 : 0.0;
+
+OutAnchorA = A;
+OutAnchorB = B;
+OutPosition = A + dirV * t + off;
+OutPosition = (isOverflow > 0.5) ? B : OutPosition;
+OutWidth = (isOverflow > 0.5) ? 0.0 : (Width * (1.0 - TrunkTaper * t));
+OutWidth = (isLastTrunk > 0.5) ? 0.0 : OutWidth;
+OutLinkOrder = (float)ipid;
+OutRevealT = t;
